# Toolchain-only deps image (platform deps-bake reads this file by name).
# Platform contract (modal_agent_adapter._build_deps_image): the build
# context contains ONLY this Dockerfile, so any COPY of repo files fails
# with "source path does not exist". Bake the toolchain here; pnpm
# install runs once at first-turn runtime and node_modules then rides
# task snapshots.
# Time: O(apt + pnpm fetch) at image build; Space: O(toolchain) in image.
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git gh ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
